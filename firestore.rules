rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Patient Profiles: Users can only read/write their own profile
    match /patients/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
      
      // Medication Subcollection
      match /medications/{medId} {
        allow read, write: if request.auth != null && request.auth.token.email == email;
      }
      
      // NEW: Appointments Subcollection
      match /appointments/{appId} {
        allow read, write: if request.auth != null && request.auth.token.email == email;
      }
    }
    
    // Documents: Users can only see records tied to their email
    match /documents/{docId} {
      allow read: if request.auth != null && resource.data.patient_email == request.auth.token.email;
      allow create: if request.auth != null && request.resource.data.patient_email == request.auth.token.email;
      allow update, delete: if false; 
    }
    
    // Audit Logs: Users can only see their own logs. Immutable (no updates/deletes)
    match /audit_logs/{logId} {
      allow read: if request.auth != null && resource.data.user == request.auth.token.email;
      allow create: if request.auth != null && request.resource.data.user == request.auth.token.email;
      allow update, delete: if false; 
    }
  }
}